{
  "$schema": "http://json.schemastore.org/prettierrc",
  "trailingComma": "none",
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "bracketSameLine": true,
  "endOfLine": "lf",
  "bracketSpacing": true,
  "printWidth": 110,
  "overrides": [
    {
      "files": ["*.json"],
      "options": {
        "tabWidth": 2,
        "printWidth": 200
      }
    }
  ]
}
