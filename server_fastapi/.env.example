# Hearthstone FastAPI — local dev (copy to .env and fill secrets)
NODE_ENV=development
BEHIND_PROXY=1
USE_S3_BUCKET=false
PORT=3000

# Azure
USE_AZURE_BLOB_BUCKET=false
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_NAME=stagecontainer

# Database
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=27017
DB_PROTOCOL=mongodb
DB_CONNECTION_STRING=mongodb://localhost:27017/backend-app

# Redis
REDIS_URL=redis://localhost:6379

# Email
EMAIL_USER=
EMAIL_PASS=
EMAIL_HOST=
EMAIL_PORT=587

# Partner feed
OFFR_IO_TOKEN=
# Static service token guarding GET /api/v1/* (header: `token`).
# Node name: Hearthstone_API_ACCESS_TOKEN.
HEARTHSTONE_API_ACCESS_TOKEN=change-me

SESSION_SECRET=d8bee2b0ce81d3b75ece7cbfda42759660c46be15a1672ca3e49b36d311b7b99
JWT_SECRET=o73WA+Ro3PIWZFy0F3JaKBqVVCGT0zTe6pYDymHjf7eJhhHYEHXUYEZi27xhvHbJU6Ib7P2goE9ED97uGvLnJA==
JWT_EXPIRE_SECONDS=7200
REFRESH_SECRET=sMBO3wxVGTGNARps+xab9B0/1w3b0FAk042q3NjL19bs8XR3eredjeXL+RFChqNqcWXrvleTeWJzenqrptE6cg==
REFRESH_EXPIRE_SECONDS=172800

# Rate limiter (Node key has typo RATE_LIMIER_NUMBER_FOR_HOUR and limiter is disabled; kept for parity)
